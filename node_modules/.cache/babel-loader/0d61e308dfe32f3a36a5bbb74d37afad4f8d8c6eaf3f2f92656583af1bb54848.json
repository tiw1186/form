}\n\n      this.submitting = true\n      try {\n        await fetch(GOOGLE_SHEET_WEBAPP_URL, {\n          method: 'POST',\n          headers: { 'Content-Type': 'text/plain;charset=utf-8' },\n          body: JSON.stringify(payload)\n        })\n        this.showSuccess = true\n        this.resetForm()\n      } catch (err) {\n        this.submitError = 'บันทึกลง Google Sheet ไม่สำเร็จ กรุณาลองใหม่อีกครั้ง หรือดาวน์โหลดข้อมูลสำรองไว้ก่อน'\n        this.downloadAsJson(payload)\n      } finally {\n        this.submitting = false\n      }\n    },\n    downloadAsJson(payload) {\n      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' })\n      const url = URL.createObjectURL(blob)\n      const a = document.createElement('a')\n      a.href = url\n      a.download = `survey-${payload.schoolName || 'data'}-${Date.now()}.json`\n      a.click()\n      URL.revokeObjectURL(url)\n    }\n  }\n}\n</script>\n"],"mappings":";;;AAyLA,SAAAA,uBAAA;AAEA,MAAAC,eAAA,IACA;EAAAC,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,EACA;AAEA,MAAAC,gBAAA,IACA,WACA,WACA,WACA,UACA,UACA,eACA;AAEA,SAAAC,UAAA;EACA;IACAC,UAAA;IACAC,QAAA;IACAC,gBAAA;IACAC,oBAAA;IACAC,gBAAA;IACAC,oBAAA;IACAC,mBAAA;IACAC,gBAAA;IACAC,cAAA;IACAC,UAAA;EACA;AACA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAb,SAAA;MACAc,SAAA;MACAC,cAAA,EAAAnB,eAAA;MACAoB,eAAA,EAAAjB,gBAAA;MACAkB,iBAAA;MACAC,UAAA;MACAC,WAAA;MACAC,WAAA;MACAC,KAAA;QACAC,QAAA,EAAAC,CAAA,IAAAA,CAAA,aAAAA,CAAA,KAAAC,SAAA,IAAAC,MAAA,CAAAF,CAAA,EAAAG,IAAA;MACA;IACA;EACA;EACAC,OAAA;IACAC,UAAA;MACA,KAAAf,IAAA,GAAAb,SAAA;MACA,KAAAmB,WAAA;MACA,KAAAF,iBAAA;MACA,KAAAY,KAAA,CAAAhB,IAAA,CAAAi