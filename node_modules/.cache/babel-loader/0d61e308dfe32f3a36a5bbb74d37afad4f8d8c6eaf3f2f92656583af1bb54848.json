{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { GOOGLE_SHEET_WEBAPP_URL } from '../config';\nconst PROBLEM_OPTIONS = [{\n  id: 1,\n  text: 'การขึ้นทะเบียนอาคาร สิ่งปลูกสร้างในที่ราชพัสดุ'\n}, {\n  id: 2,\n  text: 'การขออนุญาตรื้อถอนอาคาร สิ่งปลูกสร้าง ตัดต้นไม้ หรือขุดดิน ในที่ราชพัสดุ'\n}, {\n  id: 3,\n  text: 'การจำหน่ายอาคาร สิ่งปลูกสร้าง ต้นไม้ ดิน ในที่ราชพัสดุ'\n}, {\n  id: 4,\n  text: 'การนำวัสดุที่ได้จากการรื้อถอนไปใช้ประโยชน์'\n}, {\n  id: 5,\n  text: 'การส่งคืน/ถ่ายโอนที่ราชพัสดุ'\n}, {\n  id: 6,\n  text: 'สิ่งปลูกสร้างไม่ตรงตามทะเบียนที่ราชพัสดุ'\n}, {\n  id: 7,\n  text: 'การสำรวจและรายงานไม้มีค่าในที่ราชพัสดุ'\n}, {\n  id: 8,\n  text: 'เนื้อที่ครอบครองไม่ตรงตามทะเบียนที่ราชพัสดุ'\n}, {\n  id: 9,\n  text: 'การชี้แนวเขตและรับรองเขตที่ดิน'\n}, {\n  id: 10,\n  text: 'อาคาร สิ่งปลูกสร้าง เกิดเหตุเพลิงไหม้'\n}, {\n  id: 11,\n  text: 'กรณีมีการบุกรุกในที่ราชพัสดุ'\n}, {\n  id: 12,\n  text: 'การจัดหารายได้ในที่ราชพัสดุของโรงเรียน'\n}, {\n  id: 13,\n  text: 'กรณีอื่น ๆ ที่เกิดขึ้นในที่ราชพัสดุของโรงเรียน'\n}];\nconst DISTRICT_OPTIONS = ['หนองหาน', 'บ้านดุง', 'กู่แก้ว', 'ไชยวาน', 'ทุ่งฝน', 'พิบูลย์รักษ์'];\nfunction emptyForm() {\n  return {\n    schoolName: '',\n    district: null,\n    participant1Name: '',\n    participant1Position: '',\n    participant2Name: '',\n    participant2Position: '',\n    assetRegistrationNo: '',\n    selectedProblems: [],\n    problemDetails: {},\n    suggestion: ''\n  };\n}\nexport default {\n  name: 'SurveyForm',\n  data() {\n    return {\n      form: emptyForm(),\n      formValid: true,\n      problemOptions: PROBLEM_OPTIONS,\n      districtOptions: DISTRICT_OPTIONS,\n      showProblemsError: false,\n      submitting: false,\n      submitError: '',\n      showSuccess: false,\n      rules: {\n        required: v => v !== null && v !== undefined && String(v).trim() !== '' || 'กรุณากรอกข้อมูลนี้'\n      }\n    };\n  },\n  methods: {\n    resetForm() {\n      this.form = emptyForm();\n      this.submitError = '';\n      this.showProblemsError = false;\n      this.$refs.form.resetValidation();\n    },\n    buildPayload() {\n      const problems = this.problemOptions.map(option => ({\n        id: option.id,\n        text: option.text,\n        selected: this.form.selectedProblems.includes(option.id),\n        detail: this.form.selectedProblems.includes(option.id) ? (this.form.problemDetails[option.id] || '').trim() : ''\n      }));\n      return {\n        timestamp: new Date().toISOString(),\n        schoolName: this.form.schoolName.trim(),\n        district: this.form.district,\n        participant1Name: this.form.participant1Name.trim(),\n        participant1Position: this.form.participant1Position.trim(),\n        participant2Name: this.form.participant2Name.trim(),\n        participant2Position: this.form.participant2Position.trim(),\n        assetRegistrationNo: this.form.assetRegistrationNo.trim(),\n        problems,\n        suggestion: this.form.suggestion.trim()\n      };\n    },\n    async submitForm() {\n      this.submitError = '';\n      this.showProblemsError = false;\n      const isFormValid = this.$refs.form.validate();\n      const hasProblem = this.form.selectedProblems.length > 0;\n      if (!hasProblem) {\n        this.showProblemsError = true;\n      }\n      if (!isFormValid || !hasProblem) {\n        this.$vuetify.goTo(0);\n        return;\n      }\n      const payload = this.buildPayload();\n      if (!GOOGLE_SHEET_WEBAPP_URL || GOOGLE_SHEET_WEBAPP_URL.includes('PASTE_YOUR')) {\n        this.submitError = 'ยังไม่ได้ตั้งค่า URL สำหรับบันทึกลง Google Sheet (ดูวิธีตั้งค่าใน apps-script/README.md) — ระบบจะดาวน์โหลดข้อมูลเป็นไฟล์ JSON ให้แทน';\n        this.downloadAsJson(payload);\n        return;\n      }\n      this.submitting = true;\n      try {\n        await fetch(GOOGLE_SHEET_WEBAPP_URL, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'text/plain;charset=utf-8'\n          },\n          body: JSON.stringify(payload)\n        });\n        this.showSuccess = true;\n        this.resetForm();\n      } catch (err) {\n        this.submitError = 'บันทึกลง Google Sheet ไม่สำเร็จ กรุณาลองใหม่อีกครั้ง หรือดาวน์โหลดข้อมูลสำรองไว้ก่อน';\n        this.downloadAsJson(payload);\n      } finally {\n        this.submitting = false;\n      }\n    },\n    downloadAsJson(payload) {\n      const blob = new Blob([JSON.stringify(payload, null, 2)], {\n        type: 'application/json'\n      });\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement('a');\n      a.href = url;\n      a.download = `survey-${payload.schoolName || 'data'}-${Date.now()}.json`;\n      a.click();\n      URL.revokeObjectURL(url);\n    }\n  }\n};","map":{"version":3,"names":["GOOGLE_SHEET_WEBAPP_URL","PROBLEM_OPTIONS","id","text","DISTRICT_OPTIONS","emptyForm","schoolName","district","participant1Name","participant1Position","participant2Name","participant2Position","assetRegistrationNo","selectedProblems","problemDetails","suggestion","name","data","form","formValid","problemOptions","districtOptions","showProblemsError","submitting","submitError","showSuccess","rules","required","v","undefined","String","trim","methods","resetForm","$refs","resetValidation","buildPayload","problems","map","option","selected","includes","detail","timestamp","Date","toISOString","submitForm","isFormValid","validate","hasProblem","length","$vuetify","goTo","payload","downloadAsJson","fetch","method","headers","body","JSON","stringify","err","blob","Blob","type","url","URL","createObjectURL","a","document","createElement","href","download","now","click","revokeObjectURL"],"sources":["src/components/SurveyForm.vue"],"sourcesContent":["<template>\n  <v-container class=\"py-6 py-sm-10\" style=\"max-width: 900px\">\n    <v-card elevation=\"2\" class=\"pa-2 pa-sm-6\">\n      <v-card-title class=\"flex-column align-start\">\n        <div class=\"text-h6 text-sm-h5 font-weight-bold primary--text\">\n          แบบสำรวจรายชื่อผู้เข้าร่วมประชุม และปัญหา อุปสรรค\n          ในการดำเนินการเกี่ยวกับที่ราชพัสดุ\n        </div>\n        <div class=\"text-subtitle-2 text-sm-subtitle-1 grey--text text--darken-1\">\n          สำนักงานเขตพื้นที่การศึกษาประถมศึกษาอุดรธานี เขต 3\n        </div>\n      </v-card-title>\n      <v-divider class=\"mb-4\" />\n\n      <v-card-text>\n        <v-form ref=\"form\" v-model=\"formValid\" lazy-validation>\n          <!-- 1. ชื่อโรงเรียน -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1\">1. ชื่อโรงเรียน <span class=\"error--text\">*</span></div>\n          <v-text-field\n            v-model=\"form.schoolName\"\n            outlined\n            dense\n            placeholder=\"เช่น บ้านหนองหาน\"\n            :rules=\"[rules.required]\"\n            class=\"mb-2\"\n          />\n\n          <!-- 2. อำเภอ -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1\">2. อำเภอ <span class=\"error--text\">*</span></div>\n          <v-select\n            v-model=\"form.district\"\n            outlined\n            dense\n            :items=\"districtOptions\"\n            placeholder=\"เลือกอำเภอ\"\n            :rules=\"[rules.required]\"\n            class=\"mb-2\"\n          />\n\n          <!-- 3. ผู้เข้าร่วมประชุม 1 -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1\">3. ชื่อ - สกุล ผู้เข้าร่วมประชุมคนที่ 1</div>\n          <v-row dense>\n            <v-col cols=\"12\" sm=\"7\">\n              <v-text-field\n                v-model=\"form.participant1Name\"\n                outlined\n                dense\n                label=\"ชื่อ - สกุล\"\n              />\n            </v-col>\n            <v-col cols=\"12\" sm=\"5\">\n              <v-text-field\n                v-model=\"form.participant1Position\"\n                outlined\n                dense\n                label=\"ตำแหน่ง\"\n              />\n            </v-col>\n          </v-row>\n\n          <!-- 4. ผู้เข้าร่วมประชุม 2 -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1\">4. ชื่อ - สกุล ผู้เข้าร่วมประชุมคนที่ 2</div>\n          <v-row dense>\n            <v-col cols=\"12\" sm=\"7\">\n              <v-text-field\n                v-model=\"form.participant2Name\"\n                outlined\n                dense\n                label=\"ชื่อ - สกุล\"\n              />\n            </v-col>\n            <v-col cols=\"12\" sm=\"5\">\n              <v-text-field\n                v-model=\"form.participant2Position\"\n                outlined\n                dense\n                label=\"ตำแหน่ง\"\n              />\n            </v-col>\n          </v-row>\n\n          <!-- 5. ทะเบียนที่ราชพัสดุ -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1\">5. ทะเบียนที่ราชพัสดุ อด. <span class=\"error--text\">*</span></div>\n          <v-text-field\n            v-model=\"form.assetRegistrationNo\"\n            outlined\n            dense\n            placeholder=\"เช่น อด. 1234\"\n            :rules=\"[rules.required]\"\n            class=\"mb-2\"\n          />\n\n          <!-- 6. ปัญหาและอุปสรรค -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1\">\n            6. ปัญหาและอุปสรรคในการดำเนินการเกี่ยวกับที่ราชพัสดุของโรงเรียน\n            <span class=\"error--text\">*</span>\n            <span class=\"text-caption grey--text text--darken-1 d-block font-weight-regular\">\n              (เลือกได้มากกว่า 1 ข้อ และกรอกรายละเอียดของแต่ละข้อที่เลือก)\n            </span>\n          </div>\n\n          <v-alert\n            v-if=\"showProblemsError\"\n            type=\"error\"\n            dense\n            outlined\n            class=\"mb-2\"\n          >\n            กรุณาเลือกอย่างน้อย 1 ข้อ\n          </v-alert>\n\n          <v-card\n            v-for=\"option in problemOptions\"\n            :key=\"option.id\"\n            outlined\n            class=\"mb-2\"\n          >\n            <v-checkbox\n              v-model=\"form.selectedProblems\"\n              :value=\"option.id\"\n              :label=\"`${option.id}. ${option.text}`\"\n              dense\n              hide-details\n              class=\"ma-0 pa-3\"\n            />\n            <v-expand-transition>\n              <div\n                v-if=\"form.selectedProblems.includes(option.id)\"\n                class=\"px-4 pb-4\"\n              >\n                <v-textarea\n                  v-model=\"form.problemDetails[option.id]\"\n                  outlined\n                  dense\n                  rows=\"2\"\n                  auto-grow\n                  label=\"รายละเอียดปัญหาและอุปสรรคของข้อนี้\"\n                  :rules=\"[rules.required]\"\n                  hide-details=\"auto\"\n                />\n              </div>\n            </v-expand-transition>\n          </v-card>\n\n          <!-- 7. ข้อเสนอแนะ -->\n          <div class=\"text-subtitle-1 font-weight-medium mb-1 mt-4\">\n            7. ข้อเสนอแนะหรือแนวทางการแก้ไขปัญหาของโรงเรียน\n            <span class=\"text-caption grey--text text--darken-1 d-block font-weight-regular\">\n              (โรงเรียนสามารถระบุข้อเสนอแนะ หรือแนวทางการแก้ไขปัญหา ที่ประสงค์ให้สำนักงานเขตพื้นที่ดำเนินการ)\n            </span>\n          </div>\n          <v-textarea\n            v-model=\"form.suggestion\"\n            outlined\n            dense\n            rows=\"4\"\n            auto-grow\n            placeholder=\"ระบุข้อเสนอแนะ...\"\n          />\n\n          <v-alert v-if=\"submitError\" type=\"error\" dense outlined class=\"mt-4\">\n            {{ submitError }}\n          </v-alert>\n\n          <div class=\"d-flex flex-wrap justify-end mt-4\" style=\"gap: 8px\">\n            <v-btn text @click=\"resetForm\" :disabled=\"submitting\">ล้างแบบฟอร์ม</v-btn>\n            <v-btn\n              color=\"primary\"\n              :loading=\"submitting\"\n              @click=\"submitForm\"\n            >\n              บันทึกข้อมูล\n            </v-btn>\n          </div>\n        </v-form>\n      </v-card-text>\n    </v-card>\n\n    <v-snackbar v-model=\"showSuccess\" color=\"success\" timeout=\"4000\">\n      บันทึกข้อมูลเรียบร้อยแล้ว ขอบคุณครับ/ค่ะ\n    </v-snackbar>\n  </v-container>\n</template>\n\n<script>\nimport { GOOGLE_SHEET_WEBAPP_URL } from '../config'\n\nconst PROBLEM_OPTIONS = [\n  { id: 1, text: 'การขึ้นทะเบียนอาคาร สิ่งปลูกสร้างในที่ราชพัสดุ' },\n  { id: 2, text: 'การขออนุญาตรื้อถอนอาคาร สิ่งปลูกสร้าง ตัดต้นไม้ หรือขุดดิน ในที่ราชพัสดุ' },\n  { id: 3, text: 'การจำหน่ายอาคาร สิ่งปลูกสร้าง ต้นไม้ ดิน ในที่ราชพัสดุ' },\n  { id: 4, text: 'การนำวัสดุที่ได้จากการรื้อถอนไปใช้ประโยชน์' },\n  { id: 5, text: 'การส่งคืน/ถ่ายโอนที่ราชพัสดุ' },\n  { id: 6, text: 'สิ่งปลูกสร้างไม่ตรงตามทะเบียนที่ราชพัสดุ' },\n  { id: 7, text: 'การสำรวจและรายงานไม้มีค่าในที่ราชพัสดุ' },\n  { id: 8, text: 'เนื้อที่ครอบครองไม่ตรงตามทะเบียนที่ราชพัสดุ' },\n  { id: 9, text: 'การชี้แนวเขตและรับรองเขตที่ดิน' },\n  { id: 10, text: 'อาคาร สิ่งปลูกสร้าง เกิดเหตุเพลิงไหม้' },\n  { id: 11, text: 'กรณีมีการบุกรุกในที่ราชพัสดุ' },\n  { id: 12, text: 'การจัดหารายได้ในที่ราชพัสดุของโรงเรียน' },\n  { id: 13, text: 'กรณีอื่น ๆ ที่เกิดขึ้นในที่ราชพัสดุของโรงเรียน' }\n]\n\nconst DISTRICT_OPTIONS = [\n  'หนองหาน',\n  'บ้านดุง',\n  'กู่แก้ว',\n  'ไชยวาน',\n  'ทุ่งฝน',\n  'พิบูลย์รักษ์'\n]\n\nfunction emptyForm() {\n  return {\n    schoolName: '',\n    district: null,\n    participant1Name: '',\n    participant1Position: '',\n    participant2Name: '',\n    participant2Position: '',\n    assetRegistrationNo: '',\n    selectedProblems: [],\n    problemDetails: {},\n    suggestion: ''\n  }\n}\n\nexport default {\n  name: 'SurveyForm',\n  data() {\n    return {\n      form: emptyForm(),\n      formValid: true,\n      problemOptions: PROBLEM_OPTIONS,\n      districtOptions: DISTRICT_OPTIONS,\n      showProblemsError: false,\n      submitting: false,\n      submitError: '',\n      showSuccess: false,\n      rules: {\